{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmit": true,
    "paths": {
      "@formfill/form-model": ["./packages/form-model/src/index.ts"],
      "@formfill/conversation": ["./packages/conversation/src/index.ts"],
      "@formfill/redact": ["./packages/redact/src/index.ts"],
      "@formfill/validate": ["./packages/validate/src/index.ts"],
      "@formfill/speech": ["./packages/speech/src/index.ts"],
      "@formfill/fixtures": ["./packages/fixtures/src/index.ts"]
    }
  }
}
